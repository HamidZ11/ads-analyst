# Ad Analyst environment. Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project Settings → API). Both are public by design:
# every query runs as the signed-in user and Row Level Security decides access.
# Ad Analyst never uses a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the legacy anon key works in place of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of the site, e.g. https://<your production domain>. Sign-in
# emails return to it, and so do canonical URLs, the sitemap and robots.txt,
# which leave it out when unset or localhost. Required in production: without
# it a production build refuses to send sign-in links (development falls back
# to the request host). Set it in the production build environment. Must also
# be listed in Supabase Auth → URL Configuration as <origin>/auth/callback.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact address for Enterprise enquiries and data requests, shown as a
# mailto. Unset, anything that depends on it is hidden.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Stripe Payment Link for the Agency plan (https://buy.stripe.com/...). Only
# the fallback for deployments without Checkout: once the Stripe values below
# configure Checkout, the link is never shown. Unset, anything that depends on
# it is hidden.
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Stripe billing (server-only; setup in docs/BILLING.md). Unset, billing is off
# and no Subscribe or Manage billing control appears. Placeholders only.
# The key must start with sk_test_ unless NODE_ENV=production and
# BILLING_LIVE=true; anything else switches billing off.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_PRICE_AGENCY_MONTHLY=price_replace_me_monthly
# STRIPE_PRICE_AGENCY_YEARLY=price_replace_me_yearly
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# 32+ random characters; its SHA-256 hash is stored in public.billing_webhook_secret.
# BILLING_WEBHOOK_DB_SECRET=replace_me_with_at_least_32_random_characters
# Import gating: off unless exactly "true", and only with Checkout configured.
# BILLING_ENFORCE=false
# Live charges: only honoured in a production build, and only when exactly "true".
# BILLING_LIVE=false

# Set to "false" to stop the app asking Supabase to create accounts for new
# email addresses. Not enough on its own: anyone can call Supabase Auth with
# the public key, so also turn off "Allow new users to sign up" in Supabase.
# AD_ANALYST_ALLOW_SIGNUPS=true

# Without Supabase values, `pnpm dev` serves read-only demo data and a production
# build shows a "not connected" page. Set to "true" to force demo mode anywhere.
# AD_ANALYST_DEMO_MODE=false
